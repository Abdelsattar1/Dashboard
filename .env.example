# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Optional path to SQLite database file (defaults to ./data/sales_bi.db).
SQLITE_DB_PATH="./data/sales_bi.db"

# SESSION_SECRET: Optional secret for signing authentication tokens (auto-generated in memory if omitted).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional initial admin passcode override (if unset, use the first-run setup form in the UI).
ADMIN_PASSCODE=

# Supabase Cloud Database (used for shared persistence across Vercel devices)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

